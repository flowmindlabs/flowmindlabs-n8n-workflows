{
  "name": "31 - WhatsApp Lead Capture Agent (AiSensy)",
  "nodes": [
    {
      "parameters": {
        "content": "## WhatsApp Lead Capture Agent\n**BSP:** AiSensy (₹1,500/month)\n**Target:** Real estate, coaching, insurance, courses\n**Flow:** Prospect messages WhatsApp → AI qualifies them → logs to Airtable → notifies owner on WhatsApp\n\n**Setup:**\n1. Set AiSensy webhook to this workflow's webhook URL\n2. Add AISENSY_API_KEY in n8n credentials\n3. Update LEAD_CONFIG node with your client's details\n4. Update Airtable base/table IDs",
        "height": 220,
        "width": 440
      },
      "id": "sticky-1",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "AiSensy Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [460, 300],
      "webhookId": "whatsapp-lead-agent"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "customerPhone",
              "value": "={{ $json.body.mobile || $json.body.from || $json.mobile }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "customerMessage",
              "value": "={{ $json.body.message || $json.body.text?.body || $json.message }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "customerName",
              "value": "={{ $json.body.name || $json.name || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-1",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "businessName",
              "value": "Prestige Realty",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "businessType",
              "value": "real estate",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "offerDescription",
              "value": "2BHK and 3BHK apartments in Whitefield, Bangalore. Price range ₹65L to ₹1.2Cr. Ready to move and under-construction options available.",
              "type": "string"
            },
            {
              "id": "b4",
              "name": "qualifyingQuestions",
              "value": "1. What type of property are you looking for? (2BHK/3BHK/villa)\n2. What is your budget range?\n3. Are you looking for ready-to-move or under-construction?\n4. When are you planning to buy?\n5. Are you looking for investment or self-use?",
              "type": "string"
            },
            {
              "id": "b5",
              "name": "ownerPhone",
              "value": "+919888888888",
              "type": "string"
            },
            {
              "id": "b6",
              "name": "ownerName",
              "value": "Suresh",
              "type": "string"
            },
            {
              "id": "b7",
              "name": "airtableBase",
              "value": "appXXXXXXXXXXXXXX",
              "type": "string"
            },
            {
              "id": "b8",
              "name": "airtableTable",
              "value": "Leads",
              "type": "string"
            },
            {
              "id": "b9",
              "name": "hotLeadScore",
              "value": 70,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "config-1",
      "name": "LEAD_CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-3-5-haiku\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a friendly sales assistant for {{ $('LEAD_CONFIG').item.json.businessName }}, a {{ $('LEAD_CONFIG').item.json.businessType }} company.\\n\\nWhat we offer:\\n{{ $('LEAD_CONFIG').item.json.offerDescription }}\\n\\nYour job is to qualify leads by naturally collecting:\\n{{ $('LEAD_CONFIG').item.json.qualifyingQuestions }}\\n\\nRules:\\n- Be warm, helpful, not pushy\\n- Ask ONE question at a time\\n- After collecting all 5 answers, output this JSON block EXACTLY:\\n{\\\"action\\\": \\\"QUALIFIED\\\", \\\"name\\\": \\\"Name\\\", \\\"phone\\\": \\\"Phone\\\", \\\"propertyType\\\": \\\"...\\\", \\\"budget\\\": \\\"...\\\", \\\"timeline\\\": \\\"...\\\", \\\"purpose\\\": \\\"...\\\", \\\"score\\\": 0-100}\\n- Score 80-100: serious buyer (budget clear + short timeline)\\n- Score 50-79: warm lead (interested but timeline unclear)\\n- Score below 50: cold lead (just browsing)\\n- Keep replies under 2 sentences\\n- Support English and Hindi mix\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer name: {{ $('Extract Message Data').item.json.customerName }}\\nMessage: {{ $('Extract Message Data').item.json.customerMessage }}\"\n    }\n  ],\n  \"max_tokens\": 400\n}",
        "options": {}
      },
      "id": "claude-1",
      "name": "Claude - Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-api",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "aiReply",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "isQualified",
              "value": "={{ $json.choices[0].message.content.includes('\"action\": \"QUALIFIED\"') }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-1",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.isQualified }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-qualified",
      "name": "Lead Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "jsCode": "const reply = $('Parse AI Response').item.json.aiReply;\nconst jsonMatch = reply.match(/\\{[\\s\\S]*?\\}/m);\nif (!jsonMatch) throw new Error('No JSON in response');\nconst lead = JSON.parse(jsonMatch[0]);\nconst config = $('LEAD_CONFIG').item.json;\nconst isHot = lead.score >= config.hotLeadScore;\nreturn [{ json: {\n  ...lead,\n  isHot,\n  customerPhone: $('Extract Message Data').item.json.customerPhone,\n  ownerNotification: `🔥 New ${isHot ? 'HOT' : 'Warm'} Lead!\\nName: ${lead.name}\\nPhone: ${lead.phone || $('Extract Message Data').item.json.customerPhone}\\nProperty: ${lead.propertyType}\\nBudget: ${lead.budget}\\nTimeline: ${lead.timeline}\\nPurpose: ${lead.purpose}\\nScore: ${lead.score}/100\\n\\nReply quickly — they are interested now!`,\n  customerConfirmation: `Thank you ${lead.name}! Our team will call you within 2 hours to discuss the best options for you. Looking forward to helping you find your dream home! 🏠`\n}}];"
      },
      "id": "extract-lead",
      "name": "Extract Lead Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 200]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "={{ $('LEAD_CONFIG').item.json.airtableBase }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "={{ $('LEAD_CONFIG').item.json.airtableTable }}",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Phone": "={{ $json.customerPhone }}",
            "Property Type": "={{ $json.propertyType }}",
            "Budget": "={{ $json.budget }}",
            "Timeline": "={{ $json.timeline }}",
            "Purpose": "={{ $json.purpose }}",
            "Score": "={{ $json.score }}",
            "Status": "={{ $json.isHot ? 'Hot' : 'Warm' }}",
            "Source": "WhatsApp",
            "Created At": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "airtable-1",
      "name": "Log Lead to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1800, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-token",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://backend.aisensy.com/campaign/t1/api/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"apiKey\": \"{{ $credentials.httpHeaderAuth.value }}\",\n  \"campaignName\": \"lead_notification\",\n  \"destination\": \"{{ $('LEAD_CONFIG').item.json.ownerPhone }}\",\n  \"userName\": \"{{ $('LEAD_CONFIG').item.json.ownerName }}\",\n  \"templateParams\": [\"{{ $('Extract Lead Details').item.json.ownerNotification }}\"]\n}",
        "options": {}
      },
      "id": "notify-owner",
      "name": "Notify Owner on WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 140],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisensy-api",
          "name": "AiSensy API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://backend.aisensy.com/campaign/t1/api/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"apiKey\": \"{{ $credentials.httpHeaderAuth.value }}\",\n  \"campaignName\": \"lead_confirmation\",\n  \"destination\": \"{{ $('Extract Message Data').item.json.customerPhone }}\",\n  \"userName\": \"{{ $('Extract Lead Details').item.json.name }}\",\n  \"templateParams\": [\"{{ $('Extract Lead Details').item.json.customerConfirmation }}\"]\n}",
        "options": {}
      },
      "id": "confirm-customer",
      "name": "Confirm to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://backend.aisensy.com/campaign/t1/api/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"apiKey\": \"{{ $credentials.httpHeaderAuth.value }}\",\n  \"campaignName\": \"lead_conversation\",\n  \"destination\": \"{{ $('Extract Message Data').item.json.customerPhone }}\",\n  \"userName\": \"Customer\",\n  \"templateParams\": [\"{{ $('Parse AI Response').item.json.aiReply.replace(/\\{[\\s\\S]*?\\}/m, '').trim() }}\"]\n}",
        "options": {}
      },
      "id": "send-reply",
      "name": "Continue Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 420],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisensy-api",
          "name": "AiSensy API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\" }",
        "options": {}
      },
      "id": "respond-1",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2240, 300]
    }
  ],
