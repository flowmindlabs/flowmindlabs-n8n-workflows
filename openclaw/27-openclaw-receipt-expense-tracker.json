{
  "name": "27 - Receipt OCR Expense Tracker",
  "nodes": [
    {
      "parameters": {
        "content": "## 27 - Receipt OCR Expense Tracker\n\n**What it does:**\n- Receives a receipt image via OpenClaw (WhatsApp/Telegram photo)\n- Extracts vendor, amount, date, category using Claude Vision\n- Logs the expense to Airtable and Google Sheets\n- Sends confirmation back via OpenClaw\n\n**Setup:**\n1. Set OPENCLAW_WEBHOOK_URL and OPENCLAW_GATEWAY_TOKEN env vars\n2. Configure Airtable credentials + set AIRTABLE_BASE_ID\n3. Configure Google Sheets credentials + set SHEET_ID\n4. Create Airtable table `Expenses` with columns:\n   - Date (date)\n   - Vendor (text)\n   - Amount (number)\n   - Currency (text)\n   - Category (single select: Food/Travel/Office/Software/Other)\n   - Notes (text)\n   - Receipt Source (text)\n5. Point your OpenClaw image webhook to this workflow URL\n\n**Security note:** Only accept images from trusted OpenClaw channels.",
        "height": 420,
        "width": 380
      },
      "id": "b2000002-0002-0002-0002-000000000001",
      "name": "Setup Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, -180]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "receipt-ocr",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000002",
      "name": "OpenClaw Image Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "receipt-ocr-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f001", "name": "image_url", "value": "={{ $json.body.image_url || $json.body.file_url || '' }}", "type": "string" },
            { "id": "f002", "name": "channel_id", "value": "={{ $json.body.channel_id || $json.body.chat_id || '' }}", "type": "string" },
            { "id": "f003", "name": "sender", "value": "={{ $json.body.sender || $json.body.from || 'user' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000003",
      "name": "Extract Image Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "HTTP-Referer", "value": "flowmindlabs.co" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-sonnet-4-6\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Extract expense details from this receipt image. Return ONLY valid JSON: {\\\"vendor\\\": \\\"name\\\", \\\"amount\\\": 0.00, \\\"currency\\\": \\\"INR\\\", \\\"date\\\": \\\"YYYY-MM-DD\\\", \\\"category\\\": \\\"Food|Travel|Office|Software|Other\\\", \\\"notes\\\": \\\"any extra details\\\"}\"\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": { \"url\": \"{{ $json.image_url }}\" }\n        }\n      ]\n    }\n  ],\n  \"max_tokens\": 300\n}",
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000004",
      "name": "Claude Vision — Parse Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : raw);\n} catch(e) {\n  parsed = { vendor: 'Unknown', amount: 0, currency: 'INR', date: new Date().toISOString().split('T')[0], category: 'Other', notes: 'Parse failed' };\n}\n\nif (!parsed.date || parsed.date === '') {\n  parsed.date = new Date().toISOString().split('T')[0];\n}\n\nreturn [{ json: {\n  vendor: parsed.vendor || 'Unknown',\n  amount: parseFloat(parsed.amount) || 0,\n  currency: parsed.currency || 'INR',\n  date: parsed.date,\n  category: parsed.category || 'Other',\n  notes: parsed.notes || '',\n  channel_id: $('Extract Image Data').item.json.channel_id,\n  sender: $('Extract Image Data').item.json.sender\n}}];"
      },
      "id": "b2000002-0002-0002-0002-000000000005",
      "name": "Parse Expense",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "={{ $env.AIRTABLE_BASE_ID }}",
        "tableId": "Expenses",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.date }}",
            "Vendor": "={{ $json.vendor }}",
            "Amount": "={{ $json.amount }}",
            "Currency": "={{ $json.currency }}",
            "Category": "={{ $json.category }}",
            "Notes": "={{ $json.notes }}",
            "Receipt Source": "OpenClaw"
          }
        },
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000006",
      "name": "Log to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1200, 160],
      "credentials": {
        "airtableTokenApi": { "id": "airtable-cred", "name": "Airtable API" }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "value": "={{ $env.SHEET_ID }}", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Expenses", "__rl": true, "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.date }}",
            "Vendor": "={{ $json.vendor }}",
            "Amount": "={{ $json.amount }}",
            "Currency": "={{ $json.currency }}",
            "Category": "={{ $json.category }}",
            "Notes": "={{ $json.notes }}"
          }
        },
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000007",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1200, 440],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "gsheets-cred", "name": "Google Sheets" }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENCLAW_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"{{ $('Parse Expense').item.json.channel_id }}\",\n  \"message\": \"Expense logged: {{ $('Parse Expense').item.json.vendor }} — {{ $('Parse Expense').item.json.currency }} {{ $('Parse Expense').item.json.amount }} ({{ $('Parse Expense').item.json.category }}) on {{ $('Parse Expense').item.json.date }}\"\n}",
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000008",
      "name": "Confirm via OpenClaw",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"logged\" }",
        "options": {}
      },
      "id": "b2000002-0002-0002-0002-000000000009",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1680, 300]
    }
  ],
  "connections": {
    "OpenClaw Image Webhook": { "main": [[{ "node": "Extract Image Data", "type": "main", "index": 0 }]] },
    "Extract Image Data": { "main": [[{ "node": "Claude Vision — Parse Receipt", "type": "main", "index": 0 }]] },
    "Claude Vision — Parse Receipt": { "main": [[{ "node": "Parse Expense", "type": "main", "index": 0 }]] },
    "Parse Expense": {
      "main": [[
        { "node": "Log to Airtable", "type": "main", "index": 0 },
        { "node": "Log to Google Sheets", "type": "main", "index": 0 }
      ]]
    },
    "Log to Airtable": { "main": [[{ "node": "Confirm via OpenClaw", "type": "main", "index": 0 }]] },
    "Log to Google Sheets": { "main": [[{ "node": "Confirm via OpenClaw", "type": "main", "index": 0 }]] },
    "Confirm via OpenClaw": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "createdAt": "2026-03-24T00:00:00.000Z", "updatedAt": "2026-03-24T00:00:00.000Z", "id": "tag-openclaw", "name": "openclaw" }],
  "triggerCount": 1,
  "updatedAt": "2026-03-24T00:00:00.000Z",
  "versionId": "v1"
}
