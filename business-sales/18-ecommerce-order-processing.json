{
  "name": "18 - E-commerce Order Processing & Inventory Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopify-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000001",
      "name": "Shopify Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "shopify-order-webhook"
    },
    {
      "parameters": {
        "content": "## 18 - E-commerce Order Processing\n\n**What it does:**\nReceives Shopify order webhooks, syncs to Airtable inventory, sends Gmail confirmation to customer.\n\n**Setup:**\n1. In Shopify Admin → Settings → Notifications → Webhooks\n2. Add webhook: Order Created → this workflow URL\n3. Configure Airtable credentials and base ID\n4. Configure Gmail/SMTP credentials\n5. Update AIRTABLE_BASE_ID and TABLE_NAME in the Set node\n\n**Airtable table needs columns:**\n- Order ID (text)\n- Customer Name (text)\n- Customer Email (email)\n- Items (long text)\n- Total (currency)\n- Status (single select: Pending/Processing/Fulfilled)\n- Created At (date)",
        "height": 380,
        "width": 340
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000002",
      "name": "Setup Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, -120]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-001",
              "name": "order_id",
              "value": "={{ $json.body.id }}",
              "type": "string"
            },
            {
              "id": "field-002",
              "name": "order_number",
              "value": "={{ $json.body.order_number }}",
              "type": "string"
            },
            {
              "id": "field-003",
              "name": "customer_name",
              "value": "={{ $json.body.customer.first_name }} {{ $json.body.customer.last_name }}",
              "type": "string"
            },
            {
              "id": "field-004",
              "name": "customer_email",
              "value": "={{ $json.body.customer.email }}",
              "type": "string"
            },
            {
              "id": "field-005",
              "name": "total_price",
              "value": "={{ $json.body.total_price }}",
              "type": "string"
            },
            {
              "id": "field-006",
              "name": "currency",
              "value": "={{ $json.body.currency }}",
              "type": "string"
            },
            {
              "id": "field-007",
              "name": "line_items_summary",
              "value": "={{ $json.body.line_items.map(i => i.quantity + 'x ' + i.title).join(', ') }}",
              "type": "string"
            },
            {
              "id": "field-008",
              "name": "shipping_address",
              "value": "={{ $json.body.shipping_address ? $json.body.shipping_address.address1 + ', ' + $json.body.shipping_address.city + ', ' + $json.body.shipping_address.country : 'N/A' }}",
              "type": "string"
            },
            {
              "id": "field-009",
              "name": "created_at",
              "value": "={{ $json.body.created_at }}",
              "type": "string"
            },
            {
              "id": "field-010",
              "name": "AIRTABLE_BASE_ID",
              "value": "appXXXXXXXXXXXXXX",
              "type": "string"
            },
            {
              "id": "field-011",
              "name": "AIRTABLE_TABLE_NAME",
              "value": "Orders",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000003",
      "name": "Extract Order Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "={{ $json.AIRTABLE_BASE_ID }}",
        "tableId": "={{ $json.AIRTABLE_TABLE_NAME }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Order ID": "={{ $json.order_id }}",
            "Order Number": "={{ $json.order_number }}",
            "Customer Name": "={{ $json.customer_name }}",
            "Customer Email": "={{ $json.customer_email }}",
            "Items": "={{ $json.line_items_summary }}",
            "Total": "={{ $json.total_price }}",
            "Currency": "={{ $json.currency }}",
            "Shipping Address": "={{ $json.shipping_address }}",
            "Status": "Processing",
            "Created At": "={{ $json.created_at }}"
          }
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000004",
      "name": "Create Airtable Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [720, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-cred",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('Extract Order Data').item.json.customer_email }}",
        "subject": "Order Confirmed — #{{ $('Extract Order Data').item.json.order_number }}",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px\">\n<h2 style=\"color:#2d2d2d\">Thank you for your order!</h2>\n<p>Hi {{ $('Extract Order Data').item.json.customer_name }},</p>\n<p>Your order has been received and is being processed.</p>\n<table style=\"width:100%;border-collapse:collapse;margin:20px 0\">\n  <tr style=\"background:#f5f5f5\">\n    <td style=\"padding:10px;border:1px solid #ddd\"><strong>Order Number</strong></td>\n    <td style=\"padding:10px;border:1px solid #ddd\">#{{ $('Extract Order Data').item.json.order_number }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:10px;border:1px solid #ddd\"><strong>Items</strong></td>\n    <td style=\"padding:10px;border:1px solid #ddd\">{{ $('Extract Order Data').item.json.line_items_summary }}</td>\n  </tr>\n  <tr style=\"background:#f5f5f5\">\n    <td style=\"padding:10px;border:1px solid #ddd\"><strong>Total</strong></td>\n    <td style=\"padding:10px;border:1px solid #ddd\">{{ $('Extract Order Data').item.json.currency }} {{ $('Extract Order Data').item.json.total_price }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:10px;border:1px solid #ddd\"><strong>Shipping To</strong></td>\n    <td style=\"padding:10px;border:1px solid #ddd\">{{ $('Extract Order Data').item.json.shipping_address }}</td>\n  </tr>\n</table>\n<p>We will notify you once your order ships.</p>\n<p style=\"color:#888;font-size:12px\">This is an automated confirmation. Please do not reply to this email.</p>\n</body></html>",
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000005",
      "name": "Send Order Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 200],
      "credentials": {
        "smtp": {
          "id": "smtp-cred",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=*New Order #{{ $('Extract Order Data').item.json.order_number }}* — {{ $('Extract Order Data').item.json.customer_name }}\nItems: {{ $('Extract Order Data').item.json.line_items_summary }}\nTotal: {{ $('Extract Order Data').item.json.currency }} {{ $('Extract Order Data').item.json.total_price }}\nShipping: {{ $('Extract Order Data').item.json.shipping_address }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000006",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"received\", \"order_id\": \"{{ $('Extract Order Data').item.json.order_id }}\" }",
        "options": {}
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000007",
      "name": "Respond to Shopify",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Shopify Order Webhook": {
      "main": [
        [{ "node": "Extract Order Data", "type": "main", "index": 0 }]
      ]
    },
    "Extract Order Data": {
      "main": [
        [{ "node": "Create Airtable Record", "type": "main", "index": 0 }]
      ]
    },
    "Create Airtable Record": {
      "main": [
        [
          { "node": "Send Order Confirmation Email", "type": "main", "index": 0 },
          { "node": "Notify Slack", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Order Confirmation Email": {
      "main": [
        [{ "node": "Respond to Shopify", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    { "createdAt": "2026-03-24T00:00:00.000Z", "updatedAt": "2026-03-24T00:00:00.000Z", "id": "tag-ecommerce", "name": "e-commerce" }
  ],
  "triggerCount": 1,
  "updatedAt": "2026-03-24T00:00:00.000Z",
  "versionId": "v1"
}
